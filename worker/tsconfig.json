{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["@cloudflare/workers-types"]
    },
    "include": [
        "index.ts",
        "snapshot.ts",
        "snapshot.test.ts",
        "../src/components/apps/cellsProtocol.ts"
    ]
}
